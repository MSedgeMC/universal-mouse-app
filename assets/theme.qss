QWidget { color:#e9ebee; font-family:Ubuntu; font-size:13px; font-weight:500; }
QMainWindow, QWidget#app-root { background:#202124; }
QFrame#app-bar { background:#0b0b0d; min-height:41px; border-bottom:1px solid #292a2d; }
QFrame#brand-divider { background:#38393c; }
QFrame#device-bar { background:#191a1c; min-height:43px; }
QFrame#navigation-bar { background:#191a1c; border-bottom:1px solid #343538; }
QWidget#canvas-page, QWidget#settings-page { background:#202124; }
QLabel { background:transparent; border:0; }
QLabel[role="brand"] { font-size:12px; letter-spacing:2px; color:#e3e5e9; }
QLabel[role="app-section"] { font-size:11px; color:#92959c; letter-spacing:1px; }
QLabel[role="micro"] { font-size:10px; color:#858991; letter-spacing:.7px; }
QLabel[role="eyebrow"] { font-size:11px; color:#999da6; letter-spacing:1.4px; }
QLabel[role="device-title"] { font-size:15px; color:#dadde3; letter-spacing:1.4px; }
QLabel[role="connection"] { font-size:10px; color:#b1b6bd; }
QLabel[role="page-title"] { font-size:27px; color:#f3f4f6; font-weight:500; }
QLabel[role="section"] { font-size:12px; color:#d7dbe3; letter-spacing:.8px; }
QLabel[role="muted"] { color:#979ca6; font-size:12px; }
QLabel[role="hero-value"] { font-size:38px; color:#159bff; font-weight:500; }
QLabel[role="unit"] { font-size:13px; color:#959aa5; padding-top:13px; }
QLabel[role="preview-caption"] { font-size:17px; color:#e1e5eb; }
QLabel[role="assignment-number"] { font-size:20px; color:#159bff; }
QLabel[role="editor-title"] { font-size:21px; color:#f5f6f8; }
QFrame[surface="panel"] { background:#141517; border:1px solid #292b30; border-radius:7px; }
QFrame[role="rule"] { background:#303238; border:0; }
QFrame#assignment-panel { background:#17181b; border:1px solid #30333a; border-radius:7px; }
QFrame[surface="dpi-tile"] { background:#212328; border:1px solid #35373d; border-radius:5px; }
QFrame[surface="dpi-tile"][editing="true"] { background:#202a34; border:1px solid #159bff; }
QFrame[surface="segment"] { background:#141517; border:1px solid #45474c; border-radius:20px; }
QFrame#footer { background:#18191c; border-top:1px solid #34363c; }
QFrame#lighting-stage { background:#202124; border:0; }
QPushButton, QToolButton { background:#2a2c31; border:1px solid #45484f; border-radius:4px; padding:8px 13px; color:#dce0e7; }
QPushButton:hover, QToolButton:hover { background:#353942; border-color:#717784; color:#ffffff; }
QPushButton:pressed, QToolButton:pressed { background:#1c2027; }
QPushButton:focus, QToolButton:focus { border-color:#159bff; }
QPushButton:disabled, QToolButton:disabled { background:#202226; border-color:#34373d; color:#717681; }
QPushButton[role="primary"] { background:#159bff; color:#ffffff; border:1px solid #159bff; padding:9px 23px; }
QPushButton[role="primary"]:hover { background:#43adff; border-color:#43adff; }
QPushButton[role="primary"]:disabled { background:#263e52; border-color:#304d66; color:#8b9aac; }
QPushButton[role="secondary"] { color:#d0eaff; background:#17344b; border-color:#305772; }
QPushButton[role="quiet"] { background:transparent; border-color:#42454b; color:#bfc4ce; }
QPushButton[role="quiet"]:hover { background:#2a2e35; color:#ffffff; }
QPushButton[role="icon"], QToolButton[role="icon"] { background:transparent; border:1px solid transparent; padding:4px; }
QPushButton[role="icon"]:hover, QToolButton[role="icon"]:hover { background:#30343a; border-color:#535966; }
QPushButton[role="nav"] { background:transparent; border:1px solid transparent; border-radius:17px; color:#9ca1ab; font-size:11px; padding:7px 17px; }
QPushButton[role="nav"]:hover { background:#2a2d32; color:#edf0f4; }
QPushButton[role="nav"]:checked { background:#159bff; border-color:#159bff; color:#ffffff; }
QPushButton[role="nav"]:focus { border-color:#afd9ff; }
QPushButton[role="segment"] { background:transparent; border:1px solid transparent; border-radius:15px; padding:6px 18px; color:#a4abb7; }
QPushButton[role="segment"]:checked { background:#159bff; border-color:#159bff; color:#ffffff; }
QPushButton[role="stage-adjust"] { border:0; background:transparent; padding:3px 0; text-align:left; color:#7dbcff; font-size:11px; }
QPushButton[role="stage-adjust"]:hover { color:#c0e4ff; }
QPushButton[role="stage-adjust"]:focus { border:1px solid #159bff; }
QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit { background:#1c1e23; border:1px solid #444851; border-radius:3px; padding:7px 11px; min-height:19px; color:#e0e5ee; selection-background-color:#235782; }
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover { border-color:#6b7280; }
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus { border-color:#159bff; }
QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled { color:#727b8c; border-color:#333943; }
QComboBox#profile { background:#212227; font-size:12px; padding:5px 10px; }
QComboBox[role="dpi-value"] { font-size:23px; background:transparent; border:0; padding:3px 0; }
QComboBox[role="dpi-value"]:focus { border:1px solid #159bff; }
QComboBox::drop-down { border:0; width:26px; }
QComboBox::down-arrow { image:url(:/design/chevron.svg); width:13px; height:13px; }
QComboBox QAbstractItemView { background:#282b31; color:#e7ebf3; border:1px solid #5c6574; selection-background-color:#254d70; outline:0; padding:6px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin:border; subcontrol-position:top right; width:22px; border:0; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin:border; subcontrol-position:bottom right; width:22px; border:0; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image:url(:/design/up.svg); width:12px; height:12px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image:url(:/design/down.svg); width:12px; height:12px; }
QCheckBox, QRadioButton { spacing:8px; background:transparent; font-size:12px; }
QCheckBox::indicator { width:15px; height:15px; border:1px solid #686f7c; border-radius:3px; background:#1b1d21; }
QCheckBox::indicator:checked { image:url(:/design/check.svg); border:1px solid transparent; background:transparent; }
QCheckBox::indicator:disabled { border-color:#3f4652; }
QCheckBox::indicator:focus { border-color:#159bff; }
QRadioButton::indicator { width:15px; height:15px; border:1px solid #656d79; border-radius:8px; background:#17191c; }
QRadioButton::indicator:checked { image:url(:/design/radio.svg); background:transparent; border:1px solid transparent; }
QRadioButton::indicator:focus { border-color:#159bff; }
QTabWidget::pane { border:0; background:#202124; }
QScrollArea { border:0; background:#202124; }
QScrollArea > QWidget > QWidget { background:#202124; }
QScrollBar:vertical { background:transparent; width:5px; margin:3px 0; }
QScrollBar::handle:vertical { background:#5d636e; min-height:30px; border-radius:2px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height:0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background:none; }
QSlider::groove:horizontal { height:4px; background:#444b56; border-radius:2px; }
QSlider::sub-page:horizontal { background:#159bff; border-radius:2px; }
QSlider::handle:horizontal { width:16px; margin:-6px 0; border-radius:8px; background:#f2f4f8; }
QSlider:focus { border:1px solid #159bff; }
QSlider::handle:disabled { background:#636d7c; }
QListWidget { background:#141517; border:0; outline:0; }
QListWidget::item { background:transparent; padding:0; border:0; }
QMenu { background:#22252b; color:#dce3ef; border:1px solid #505965; padding:7px; }
QMenu::item { padding:9px 19px; }
QMenu::item:selected { background:#24486a; }
QToolButton::menu-indicator { image:none; }
QGroupBox { background:#17191d; border:1px solid #454d5a; border-radius:5px; margin-top:17px; padding:16px; }
QGroupBox::title { subcontrol-origin:margin; left:17px; color:#c2cad7; }
QToolTip { background:#292e36; color:#e9edf4; border:1px solid #5d6b7c; padding:7px; }
QDialog, QMessageBox { background:#202328; }
